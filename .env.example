NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
GOOGLE_GENERATIVE_AI_API_KEY=       # free tier at aistudio.google.com; used when ANTHROPIC_API_KEY is empty
AI_MODEL_GOOGLE=gemini-3.8-flash      # comma list "main,fallback": pick "flash-lite" models with a high per-minute limit (docs/DEPLOY.md)
# AI_MODEL_CHAT_GOOGLE=             # optional separate Gemini model for the tutor chat (its own free-tier limit)
AI_RPM_LIMIT=10                     # AI requests per minute the whole app sends (stay under the free-tier limit)
# AI_PROVIDER=google                # pick Gemini even when both keys are set
AI_VISION_MODEL=claude-sonnet-5-5   # photo-of-notebook import (Phase 6)
AI_DAILY_LIMIT_PER_USER=100
AI_GLOBAL_DAILY_LIMIT=3000
SIGNUP_LIMIT_PER_HOUR=8             # sign-ups per client IP per hour
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
# Web Push reminders: pnpm exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=                        # any long random string; Vercel Cron sends it as a Bearer token
ADMIN_EMAILS=                       # optional, comma separated: always admins of /admin (or grant with pnpm admin:grant <email>)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
